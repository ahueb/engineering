{
  "model": "sonnet",
  "modelSettings": {
    "claude-sonnet-5": {
      "effortLevel": "low"
    }
  },
  "env": {
    "OTHERVAR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff)"
    ]
  },
  "extraKnownMarketplaces": {
    "widgets": {
      "source": {
        "source": "github",
        "repo": "acme/widgets"
      }
    }
  },
  "enabledPlugins": {
    "lathe@lathe": true,
    "sample@claude-plugins-official": true
  }
}
