#!/usr/bin/env bash
# Shim for ci.sh scenario 19a: reports a `claude` CLI too old to satisfy
# install.sh's >= 2.1.267 precondition. Every other invocation execs the real
# `claude` found on PATH (skipping this shim itself), so if the precondition
# check is somehow bypassed the rest of the flow still behaves realistically.
set -euo pipefail

find_real() {
  if [ -n "${REAL_CLAUDE:-}" ]; then
    printf '%s\n' "$REAL_CLAUDE"
    return 0
  fi
  local self
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  while IFS= read -r c; do
    local rc
    rc="$(cd "$(dirname "$c")" && pwd)/$(basename "$c")"
    if [ "$rc" != "$self" ]; then
      printf '%s\n' "$c"
      return 0
    fi
  done < <(type -aP claude)
  return 1
}

if [ "${1:-}" = "--version" ]; then
  echo "2.1.200 (Claude Code)"
  exit 0
fi

REAL="$(find_real)" || { echo "claude-old shim: no real claude found on PATH" >&2; exit 127; }
exec "$REAL" "$@"
