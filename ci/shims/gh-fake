#!/usr/bin/env bash
# Fake `gh` for ci.sh's release scenarios. Records every invocation (one line
# per call, the arguments space-joined) in $GH_FAKE_LOG and answers the calls
# release.sh makes without any network:
#   auth status        -> exit 0 (authenticated), unless GH_FAKE_AUTH_FAIL=1 -> exit 1
#   pr create ...      -> prints a PR URL, exit 0
#   pr checks ...      -> exit 0 (checks green)
#   pr checks --json   -> with GH_FAKE_NO_CHECKS_CALLS=N, the first N calls print "no checks
#                         reported" and exit 1, as gh does before GitHub registers a new PR's
#                         checks; later calls print 3 (the number of checks)
#   pr merge ...       -> exit 0 (merged)
# Anything else exits 0 silently, so an added call shows up in the log rather
# than failing the scenario for the wrong reason.
set -euo pipefail

if [ -n "${GH_FAKE_LOG:-}" ]; then
  printf '%s\n' "$*" >> "$GH_FAKE_LOG"
fi

case "${1:-}" in
  auth)
    if [ "${GH_FAKE_AUTH_FAIL:-0}" = "1" ]; then
      exit 1
    fi
    exit 0
    ;;
  pr)
    case "${2:-}" in
      create)
        echo "https://github.com/ahueb/lathe/pull/1"
        exit 0
        ;;
      checks)
        case " $* " in
          *" --json "*)
            count_file="${GH_FAKE_LOG:-/dev/null}.checks"
            n=0
            if [ -f "$count_file" ]; then n="$(cat "$count_file")"; fi
            n=$((n + 1))
            if [ -n "${GH_FAKE_LOG:-}" ]; then echo "$n" > "$count_file"; fi
            if [ "$n" -le "${GH_FAKE_NO_CHECKS_CALLS:-0}" ]; then
              echo "no checks reported on the '${3:-}' branch" >&2
              exit 1
            fi
            echo 3
            exit 0
            ;;
        esac
        echo "gh-fake: all checks passed"
        exit 0
        ;;
      merge)
        echo "gh-fake: merged"
        exit 0
        ;;
    esac
    ;;
esac

exit 0
