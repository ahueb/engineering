#!/usr/bin/env bash
# Shim for ci.sh scenario 22: satisfies install.sh's python3 >= 3.8
# precondition probes as Python 3.7.9, so install.sh exits before any write.
# install.sh probes exactly two ways: `python3 -c 'import sys; sys.exit(0 if
# sys.version_info >= (3, 8) else 1)'` (must fail) and, for the error
# message, `python3 -c 'import platform; print(platform.python_version())'`
# (must print 3.7.9). `python3 --version` is also handled for completeness.
# Everything else execs the real python3 found on PATH (skipping this shim).
set -euo pipefail

find_real() {
  if [ -n "${REAL_PYTHON3:-}" ]; then
    printf '%s\n' "$REAL_PYTHON3"
    return 0
  fi
  local self
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  while IFS= read -r c; do
    local rc
    rc="$(cd "$(dirname "$c")" && pwd)/$(basename "$c")"
    if [ "$rc" != "$self" ]; then
      printf '%s\n' "$c"
      return 0
    fi
  done < <(type -aP python3)
  return 1
}

case "$*" in
  *sys.version_info*) exit 1 ;;
  *platform.python_version*) echo "3.7.9"; exit 0 ;;
esac

if [ "${1:-}" = "--version" ]; then
  echo "Python 3.7.9"
  exit 0
fi

REAL="$(find_real)" || { echo "python3-old shim: no real python3 found on PATH" >&2; exit 127; }
exec "$REAL" "$@"
