#!/usr/bin/env bash
# Shim for ci.sh scenario 19c: behaves as the real `claude` CLI (including a
# real, successful `plugin install`), except that `plugin list --json`
# reports a fabricated installed version ("0.0.0-legacy") for
# engineering@engineering. The scenario pre-creates
# $CFG/plugins/cache/engineering/engineering/0.0.0-legacy/hooks/session-start.sh
# whose content does NOT contain "rules/engineering-policy.md", so
# install.sh's decision-1 capability gate falls back to --policy-target
# claude-md and prints the fallback message, exactly as it would for a real
# pre-2.8.0 installed plugin.
set -euo pipefail

find_real() {
  if [ -n "${REAL_CLAUDE:-}" ]; then
    printf '%s\n' "$REAL_CLAUDE"
    return 0
  fi
  local self
  self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  while IFS= read -r c; do
    local rc
    rc="$(cd "$(dirname "$c")" && pwd)/$(basename "$c")"
    if [ "$rc" != "$self" ]; then
      printf '%s\n' "$c"
      return 0
    fi
  done < <(type -aP claude)
  return 1
}

REAL="$(find_real)" || { echo "claude-old-plugin shim: no real claude found on PATH" >&2; exit 127; }

if [ "${1:-}" = "plugin" ] && [ "${2:-}" = "list" ]; then
  echo '[{"name":"engineering@engineering","version":"0.0.0-legacy"}]'
  exit 0
fi

exec "$REAL" "$@"
